# ---- Core ----
ENVIRONMENT=production
# Use the compose service name "db" when running via docker compose prod; otherwise your managed Postgres URL.
DATABASE_URL=postgresql://hustle:change-me@db:5432/hustle
# Generate a long random secret and keep it stable (rotating it invalidates all sessions).
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Origins / URLs ----
# Must exactly match the frontend origin (credentials/cookies).
CORS_ORIGIN=https://app.example.com
# Used to build email links (verify/reset).
FRONTEND_URL=https://app.example.com

# ---- SMTP (real provider in prod) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# ---- Storage ----
# In Docker this is mounted to a volume; on bare metal set an absolute path and back it up.
UPLOAD_DIR=/app/uploads
